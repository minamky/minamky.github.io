# Copy to .env.local for local Vercel dev (`vercel dev`) — never commit real secrets.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# For scripts/get-spotify-refresh-token.mjs only — must match Spotify Dashboard → Redirect URIs:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
